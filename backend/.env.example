# ============================================================
# RUTACOMPARTIDA - Variables de entorno (Backend Go + Docker)
# Copiar a .env para desarrollo local. NUNCA subir .env a Git.
# ============================================================

# --- Aplicación ---
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Lima
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# URL pública en la nube cuando se despliega para pruebas con teléfonos físicos
# Ejemplo: https://api-rutacompartida.up.railway.app
CLOUD_PUBLIC_API_URL=

# --- Base de datos PostgreSQL 16 + PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rutacompartida
POSTGRES_USER=rutacompartida
POSTGRES_PASSWORD=rutacompartida_dev_pass
DATABASE_URL=postgres://rutacompartida:rutacompartida_dev_pass@localhost:5432/rutacompartida?sslmode=disable

# --- Autenticación JWT ---
# En producción usar secretos aleatorios >= 32 caracteres
JWT_ACCESS_SECRET=dev_access_secret_cambiar_en_produccion_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_cambiar_en_produccion_32chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Almacenamiento de archivos (MinIO local / S3 compatible en nube) ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET_PUBLIC=rutacompartida-public
STORAGE_BUCKET_PRIVATE=rutacompartida-private
STORAGE_USE_SSL=false
STORAGE_PRESIGNED_TTL_SECONDS=300

# --- Ruteo y polilíneas (OSRM) ---
# Valores permitidos: osrm_public | osrm_local | mock
ROUTING_PROVIDER=osrm_public
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_LOCAL_URL=http://localhost:5000
OSRM_TIMEOUT_SECONDS=8

# --- Pasarela de pagos ---
# Valores permitidos: mock | culqi | mercadopago
PAYMENT_PROVIDER=mock
# Resultado por defecto cuando no se envía header X-Mock-Payment-Result: success | failed
PAYMENT_MOCK_DEFAULT_RESULT=success

# --- Verificación de identidad (DNI) y OTP ---
# Valores permitidos: mock | reniec_kyc
IDENTITY_PROVIDER=mock
# Si es true, las solicitudes de verificación se aprueban automáticamente en dev
IDENTITY_MOCK_AUTO_APPROVE=false

# Valores permitidos: mailpit_console | smtp | twilio
OTP_PROVIDER=mailpit_console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rutacompartida.local
OTP_TTL_MINUTES=10

# --- Notificaciones Push ---
# Valores permitidos: mock | fcm
PUSH_PROVIDER=mock
FCM_CREDENTIALS_JSON=

# --- Scheduler interno (expiraciones 60s, créditos 24h, calificaciones 24h, GPS 30d) ---
SCHEDULER_ENABLED=true
SCHEDULER_HOLD_POLL_SECONDS=5
SCHEDULER_CREDITS_POLL_SECONDS=60
SCHEDULER_RATINGS_POLL_SECONDS=60
SCHEDULER_GPS_RETENTION_POLL_MINUTES=60
